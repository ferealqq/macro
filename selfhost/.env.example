# Generated by selfhost/install.sh. Replace __TOKENS__ only when writing this
# file by hand. Do not commit the filled-in .env.

# Public host, no scheme. localhost for a machine you open directly, or
# 185-20-139-20.sslip.io for a server whose name is its address.
DOMAIN=__DOMAIN__
SELFHOST_GOOGLE=false

ENVIRONMENT=local
MACRO_SELF_HOST=true
RUST_LOG=info

# --- data stores ---
POSTGRES_USER=macro
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
POSTGRES_DB=macrodb
FUSIONAUTH_DB_PASSWORD=__FUSIONAUTH_DB_PASSWORD__
DATABASE_URL=postgres://macro:__POSTGRES_PASSWORD__@postgres:5432/macrodb
DATABASE_URL_READONLY=postgres://macro:__POSTGRES_PASSWORD__@postgres:5432/macrodb
MACRO_DB_URL=postgres://macro:__POSTGRES_PASSWORD__@postgres:5432/macrodb
REDIS_URI=redis://redis:6379
REDIS_HOST=redis://redis:6379
DOCUMENT_STORAGE_SERVICE_REDIS_URI=redis://redis:6379
LAST_ONLINE_REDIS_URI=redis://redis:6379
OPENSEARCH_URL=http://search:9200
OPENSEARCH_USERNAME=macrouser
OPENSEARCH_PASSWORD=local
KAFKA_BROKERS=kafka:29092

LOCAL_AWS_URL=http://localstack:4566
LOCAL_AWS_PUBLIC_URL=https://__DOMAIN__/local-storage
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
DOCUMENT_STORAGE_BUCKET=doc-storage
DOCX_DOCUMENT_UPLOAD_BUCKET=docx-upload
STATIC_STORAGE_BUCKET=static-file-storage
UPLOAD_STAGING_BUCKET=bulk-upload-staging
ATTACHMENT_BUCKET=macro-email-attachments
GITHUB_PULL_REQUEST_PATCH_BUCKET=github-pull-request-patches
AGENT_SESSION_CHANGES_BUCKET=agent-session-changes
CALL_RECORDING_BUCKET_NAME=macro-call-recording-local
BULK_UPLOAD_REQUESTS_TABLE=bulk-upload
CONNECTION_GATEWAY_TABLE=connection-gateway-table
STATIC_FILE_SERVICE_DYNAMODB_TABLE_NAME=static-file-metadata
DOCUMENT_STORAGE_SERVICE_CLOUDFRONT_DISTRIBUTION_URL=https://__DOMAIN__/local-storage/doc-storage
DOCUMENT_STORAGE_SERVICE_CLOUDFRONT_SIGNER_PUBLIC_KEY_ID=local-cloudfront-signer
DOCUMENT_STORAGE_SERVICE_CLOUDFRONT_SIGNER_PRIVATE_KEY=local
DOCUMENT_STORAGE_SERVICE_CLOUDFRONT_SIGNER_PRIVATE_KEY_SECRET_NAME=local-cloudfront-signer-private-key
OVERRIDE_DOCUMENT_UPLOAD_FINALIZER_QUEUE=http://localstack:4566/000000000000/document-upload-finalizer-queue
DOCUMENT_UPLOAD_FINALIZER_QUEUE_URL=http://localstack:4566/000000000000/document-upload-finalizer-queue
OVERRIDE_STATIC_FILE_SERVICE_S3_EVENT_QUEUE_URL=http://localstack:4566/000000000000/static-file-s3-event-notification-queue
CURSOR_API_KEY_KMS_KEY_ID=alias/macro-local-cursor-api-key
CODEX_OAUTH_KMS_KEY_ID=alias/macro-local-codex-oauth
MCP_OAUTH_KMS_KEY_ID=alias/macro-local-mcp-oauth

# --- service URLs (container network) ---
BASE_URL=https://__DOMAIN__/auth
FRONTEND_ORIGIN=https://__DOMAIN__/app
OVERRIDE_APP_SERVICE_URL=https://__DOMAIN__
OVERRIDE_COGNITION_PUBLIC_URL=https://__DOMAIN__/cognition
OVERRIDE_AUTH_SERVICE_URL=http://authentication-service:8080
OVERRIDE_DOCUMENT_STORAGE_SERVICE_URL=http://document-storage-service:8080
OVERRIDE_DOCUMENT_COGNITION_SERVICE_URL=http://document-storage-service:8080/cognition
OVERRIDE_CONNECTION_GATEWAY_URL=http://connection-gateway:8080
OVERRIDE_CONNECTION_GATEWAY_WEBSOCKET_URL=ws://connection-gateway:8080
OVERRIDE_LEXICAL_SERVICE_URL=http://lexical-service:8096
OVERRIDE_SYNC_SERVICE_URL=http://sync-service:8787
OVERRIDE_STATIC_FILE_SERVICE_URL=http://static-file-service:8080
OVERRIDE_STATIC_FILE_PUBLIC_URL=https://__DOMAIN__/static-file

# --- identity. Secrets below are generated by install.sh. ---
FUSIONAUTH_BASE_URL=http://fusionauth:9011
FUSIONAUTH_PUBLIC_URL=https://__DOMAIN__
FUSIONAUTH_APP_URL=https://__DOMAIN__
FUSIONAUTH_API_KEY=__FUSIONAUTH_API_KEY__
FUSIONAUTH_API_KEY_SECRET_KEY=__FUSIONAUTH_API_KEY__
FUSIONAUTH_CLIENT_ID=22222222-2222-4222-8222-222222222222
FUSIONAUTH_CLIENT_SECRET_KEY=__CLIENT_SECRET__
FUSIONAUTH_OAUTH_REDIRECT_URI=https://__DOMAIN__/auth/oauth/redirect
FUSIONAUTH_ADMIN_PASSWORD=__ADMIN_PASSWORD__
AUDIENCE=22222222-2222-4222-8222-222222222222
ISSUER=local.macro.com
JWT_SECRET_KEY=__JWT_SECRET__
INTERNAL_API_SECRET_KEY=__INTERNAL_KEY__
INTERNAL_API_KEY=__INTERNAL_KEY__
INTERNAL_AUTH_KEY=__INTERNAL_KEY__
AUTHENTICATION_SERVICE_SECRET_KEY=__INTERNAL_KEY__
SERVICE_INTERNAL_AUTH_KEY=__INTERNAL_KEY__
DOCUMENT_STORAGE_SERVICE_AUTH_KEY=__INTERNAL_KEY__
SYNC_SERVICE_AUTH_KEY=__INTERNAL_KEY__
DOCUMENT_PERMISSION_JWT=__DOC_PERM__
DOCUMENT_PERMISSIONS_SECRET=__DOC_PERM__
DSS_INTERNAL_AUTH_KEY=__INTERNAL_KEY__
ACCOUNT_LINK_STATE_SECRET=__ACCOUNT_LINK__
MCP_CREDENTIALS_KEY_SECRET_NAME=__MCP_KEY__

# Optional Google sign-in. Set both, set SELFHOST_GOOGLE=true, then recreate
# the FusionAuth volume (the kickstart runs only on an empty database).
# Redirect URI in Google Cloud: https://__DOMAIN__/oauth2/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET_KEY=

# GitHub account link (OAuth app). Callback:
# https://__DOMAIN__/auth/oauth2/github/callback
# A non-empty value that does not start with local- is written into FusionAuth
# on first boot so the connect button can redirect. Replace the placeholders
# with the app you create. See selfhost/integrations/README.md.
GITHUB_CLIENT_ID=selfhost-github-client
GITHUB_CLIENT_SECRET=selfhost-github-secret
GITHUB_IDP_ID=99999999-9999-4999-8999-999999999999

# GitHub App (repository sync). Install URL is
# https://__DOMAIN__/dss/github/install-sync
# Webhook URL is https://__DOMAIN__/dss/github/webhook
GITHUB_SYNC_APP_URL=https://github.com/apps/replace-me
GITHUB_SYNC_APP_CLIENT_ID=selfhost-github-app
GITHUB_SYNC_APP_CLIENT_SECRET=selfhost-github-app-secret
GITHUB_SYNC_APP_PEM_SECRET_KEY=local-github-sync-pem
GITHUB_WEBHOOK_SECRET_KEY=selfhost-github-webhook
GITHUB_INSTALLATION_STATE_SECRET=selfhost-github-installation-state-0123456789

# Slack MCP app. Redirect:
# https://__DOMAIN__/cognition/mcp/servers/auth/callback
SLACK_MCP_CLIENT_ID=selfhost-slack-client
SLACK_MCP_CLIENT_SECRET=selfhost-slack-secret

# Optional SMTP for the emailed login code. Password sign-in does not use it.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURITY=NONE
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@localhost

# Loaders that still require a value. These do not call Stripe or PostHog.
POSTHOG_API_KEY=local-posthog-project-key
POSTHOG_HOST=https://us.i.posthog.com
STRIPE_SECRET_KEY=local-stripe-secret
STRIPE_PRICE_ID=price_local
STRIPE_WEBHOOK_SECRET_KEY=local-stripe-webhook-secret
STRIPE_COMPUTER_STANDARD_MONTHLY_PRICE_ID=price_local_computer_standard_monthly
STRIPE_COMPUTER_LARGE_MONTHLY_PRICE_ID=price_local_computer_large_monthly
STRIPE_COMPUTER_XL_MONTHLY_PRICE_ID=price_local_computer_xl_monthly
STRIPE_COMPUTER_STANDARD_YEARLY_PRICE_ID=price_local_computer_standard_yearly
STRIPE_COMPUTER_LARGE_YEARLY_PRICE_ID=price_local_computer_large_yearly
STRIPE_COMPUTER_XL_YEARLY_PRICE_ID=price_local_computer_xl_yearly
AI_USAGE_FREE_INCLUDED_ALLOWANCE_CENTS=500
AI_USAGE_INCLUDED_ALLOWANCE_CENTS=1500
AI_USAGE_MAX_INCLUDED_ALLOWANCE_CENTS=15000
AI_USAGE_OVERAGE_MARKUP_PERCENT=25
ENABLE_AI_USAGE_ENFORCEMENT=false
ENABLE_AI_USAGE_BILLING=false
LIVEKIT_SERVER_URL=http://127.0.0.1:9
LIVEKIT_API_KEY=local-livekit-key
LIVEKIT_API_SECRET=local-livekit-secret
OPENAI_API_KEY=local-openai-key
ANTHROPIC_API_KEY=local-anthropic-key
COHERE_API_KEY=local-cohere-key
CEREBRAS_API_KEY=local-cerebras-key
FIREWORK_API_KEY=local-firework-key
CAL_WEBHOOK_SECRET_KEY=local-cal-webhook-secret
CAL_EVENT_TYPE_CONTENT_NAMES_KEY={"1":{"content_name":"local","value":0}}
META_PIXEL_ID=local-meta-pixel
META_ACCESS_TOKEN=local-meta-access-token
PIPEDREAM_CLIENT_ID=local-pipedream-client
PIPEDREAM_CLIENT_SECRET=local-pipedream-secret
PIPEDREAM_PROJECT_ID=proj_local
HARNESS_BOT_ID=00000000-0000-0000-0000-00000000a9e7
