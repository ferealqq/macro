# Self-host reverse proxy. DOMAIN is the public host (no scheme), for example
# localhost or a public name such as your-host.example. Caddy obtains a certificate: an
# internal one for localhost, a public one when the name resolves here.

{$DOMAIN} {
	encode zstd gzip

	handle /selfhost.json {
		header Content-Type application/json
		respond `{"google":{$SELFHOST_GOOGLE:false}}`
	}

	handle_path /auth/* {
		reverse_proxy authentication-service:8080
	}

	# FusionAuth's browser half of Google sign-in. The service builds the
	# authorize URL on https://DOMAIN, and Google returns to /oauth2/callback.
	handle /oauth2/* {
		reverse_proxy fusionauth:9011
	}

	@connection_gateway path /connection-gateway /connection-gateway/*
	handle @connection_gateway {
		uri strip_prefix /connection-gateway
		reverse_proxy connection-gateway:8080
	}

	handle_path /dss/* {
		reverse_proxy document-storage-service:8080
	}

	# Onboarding lives on the agent service, which this stack does not run.
	# Answer the two calls so a new account can enter the app.
	handle /cognition/onboarding {
		header Content-Type application/json
		respond `{"row":{"status":"completed","skipped":true,"started_at":"2026-01-01T00:00:00Z","completed_at":"2026-01-01T00:00:00Z"},"connected_servers":[],"suggested_team_domain":null}` 200
	}
	handle /cognition/onboarding/* {
		header Content-Type application/json
		respond `{"status":"completed","skipped":true,"started_at":"2026-01-01T00:00:00Z","completed_at":"2026-01-01T00:00:00Z"}` 200
	}

	# Slack and the other MCP connectors, mounted by document storage in
	# self-host mode. Do not strip the prefix: the routes include /cognition.
	handle /cognition/* {
		reverse_proxy document-storage-service:8080
	}

	@sync path /sync /sync/*
	handle @sync {
		uri strip_prefix /sync
		reverse_proxy sync-service:8787 {
			header_up Origin http://localhost:3000
		}
	}

	handle_path /lexical/* {
		reverse_proxy lexical-service:8096
	}

	handle_path /local-storage/* {
		@cdn_signed query Key-Pair-Id=*
		uri @cdn_signed query {
			-Signature
			-Expires
			-Key-Pair-Id
		}
		reverse_proxy localstack:4566
	}

	handle_path /static-file/* {
		route {
			@svc path /api/* /internal/*
			reverse_proxy @svc static-file-service:8080
			rewrite * /static-file-storage{uri}
			reverse_proxy localstack:4566
		}
	}

	# Services this build does not run. A fast answer beats a hung request.
	@unsupported path /email/* /calendar/* /unfurl/* /image-proxy/* /agent-harness/* /preview* /scheduled-action* /mcp* /websocket* /notification/* /contacts/* /i/* /ai-editing/*
	handle @unsupported {
		respond "Not enabled on this server" 503
	}

	redir / /app/ 302
	redir /app /app/ 308
	handle_path /app/* {
		root * /srv/frontend
		try_files {path} /index.html
		file_server
	}
}
